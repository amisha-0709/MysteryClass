# Copy to backend/.env and fill in. Never commit the real file.

# Gnani Vachana API key (Prisma STT + Timbre TTS). Required from Milestone 3.
GNANI_API_KEY=

# Optional: enables the LLM intent/paraphrase layer (Milestone 5). Leave blank for deterministic mode.
ANTHROPIC_API_KEY=

# Comma-separated origins allowed to call the API directly (the Vite dev proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173
